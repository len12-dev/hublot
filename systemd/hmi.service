[Unit]
Description=Interface HMI (serveur web de configuration)
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/hmi
Environment=HMI_CONFIG=/etc/hmi/config.json
ExecStart=/opt/hmi/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:80 main:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
