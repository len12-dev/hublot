[Unit]
Description=Hublot (serveur web de configuration)
After=NetworkManager.service network-online.target
Wants=network-online.target

[Service]
WorkingDirectory=/opt/hublot
Environment=HUBLOT_CONFIG=/etc/hublot/config.json
ExecStart=/opt/hublot/venv/bin/gunicorn --workers 2 --bind 0.0.0.0:80 main:app
Restart=on-failure

[Install]
WantedBy=multi-user.target
